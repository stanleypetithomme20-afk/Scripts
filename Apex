-- FPS / GPS
--------------------------------------------------------

local frames = 0
local lastFPS = os.clock()
local currentFPS = 60

RunService.RenderStepped:Connect(function()

	frames += 1

	local now = os.clock()

	if now - lastFPS >= .5 then

		currentFPS = math.floor(
			frames / (now - lastFPS)
		)

		frames = 0
		lastFPS = now
	end

	refreshWalkSpeed()
	refreshJumpPower()

	if Settings.FPSBoost then

		Stats.Visible = true

		FPS.Text =
			"FPS: " .. tostring(currentFPS)

		Boost.Text = "BOOST: ON"
		Boost.TextColor3 = C.Green

		if Root then

			local p = Root.Position

			GPS.Text = string.format(
				"GPS: %.0f, %.0f, %.0f",
				p.X,
				p.Y,
				p.Z
			)
		end

	else

		Stats.Visible = false
	end

	if Settings.ESP then
		updateESP()
	end

	if Settings.VisualHitbox then
		updateHitboxes()
	end
end)

