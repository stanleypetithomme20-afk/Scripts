--------------------------------------------------------
-- RAYCAST
--------------------------------------------------------

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function updateRayFilter()

	if Character then
		RayParams.FilterDescendantsInstances = {Character}
	end
end

local function flat(v)

	local xz = Vector3.new(v.X, 0, v.Z)

	if xz.Magnitude < .001 then
		return Vector3.zero
	end

	return xz.Unit
end

--------------------------------------------------------
-- WALL DETECTION
--------------------------------------------------------

local function getWall()

	if not Root or not Character then
		return nil
	end

	updateRayFilter()

	local pos = Root.Position

	local origins = {
		pos,
		pos + Vector3.new(0, 1.2, 0),
		pos + Vector3.new(0, -.7, 0)
	}

	local forward = flat(Root.CFrame.LookVector)
	local right = flat(Root.CFrame.RightVector)

	local directions = {
		forward,
		-forward,
		right,
		-right,

		flat(forward + right * .5),
		flat(forward - right * .5)
	}

	local closest
	local closestDistance = math.huge

	for _, origin in ipairs(origins) do

		for _, direction in ipairs(directions) do

			if direction.Magnitude > .01 then

				local hit = workspace:Raycast(
					origin,
					direction * Settings.WallDistance,
					RayParams
				)

				if hit
					and hit.Instance
					and hit.Instance.CanCollide then

					if math.abs(hit.Normal.Y) < .55 then

						local distance =
							(hit.Position - origin).Magnitude

						if distance < closestDistance then
							closestDistance = distance
							closest = hit
						end
					end
				end
			end
		end
	end

	return closest
end

--------------------------------------------------------
-- WALL HOP
--------------------------------------------------------

local LastWallHop = 0

local function wallHop()

	if not Settings.WallHop then
		return
	end

	if not Humanoid or not Root then
		return
	end

	-- Only wall-hop while airborne.
	if Humanoid.FloorMaterial ~= Enum.Material.Air then
		return
	end

	local now = os.clock()

	if now - LastWallHop < .14 then
		return
	end

	local wall = getWall()

	if not wall then
		return
	end

	local normal = flat(wall.Normal)

	if normal.Magnitude < .01 then
		return
	end

	local velocity = Root.AssemblyLinearVelocity

	local horizontal =
		Vector3.new(
			velocity.X,
			0,
			velocity.Z
		)

	-- Remove velocity going into the wall.
	local intoWall = horizontal:Dot(-normal)

	if intoWall > 0 then
		horizontal += normal * intoWall
	end

	horizontal *= Settings.MovementPreserve

	horizontal += normal * Settings.WallPush

	local maxHorizontal = 45

	if horizontal.Magnitude > maxHorizontal then
		horizontal = horizontal.Unit * maxHorizontal
	end

	Root.AssemblyLinearVelocity = Vector3.new(
		horizontal.X,
		math.max(Settings.WallPower, 35),
		horizontal.Z
	)

	LastWallHop = now

	Humanoid:ChangeState(
		Enum.HumanoidStateType.Jumping
	)
end

